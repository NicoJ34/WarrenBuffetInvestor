# ── Base de données ──────────────────────────────────────────────────────────
# Dev local (Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warren_buffet
# Production (Supabase — utiliser le connection pooler Supavisor)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend (NextAuth) ───────────────────────────────────────────────────────
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
# URL du backend — utilisée par NextAuth côté serveur pour appeler l'API Python
BACKEND_URL=http://localhost:8000
# URL de l'API pour les appels client (vide = même domaine en production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Email (reset password) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@warren-buffet-investor.app

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
ENVIRONMENT=development

# ── Cron (sécurise les endpoints /api/cron/*) ─────────────────────────────────
# Vercel envoie ce header automatiquement. En dev local, passer le même token.
CRON_SECRET=change-me-generate-with-openssl-rand-hex-32
